# Firebase Web Config (Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Gemini 2.5 Flash - used ONLY by Cloud Functions (server-side), never exposed to client
GEMINI_API_KEY=

# Optional: if using Google Maps instead of the default Leaflet/OpenStreetMap setup
VITE_GOOGLE_MAPS_API_KEY=
