rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /vault/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid
                          && request.resource.size < 10 * 1024 * 1024;
    }
    match /notices/{fileName} {
      allow read: if true;
      allow write: if request.auth != null; // admins/CMS upload notices for the extraction agent
    }
  }
}
