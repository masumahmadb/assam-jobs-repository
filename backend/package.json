{
  "name": "pdf-suite-backend",
  "version": "1.0.0",
  "description": "PDF Suite Backend - Free/Open-Source PDF Processing API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker:ocr": "node workers/ocr-worker.js",
    "worker:convert": "node workers/convert-worker.js",
    "worker:compress": "node workers/compress-worker.js",
    "worker:table": "node workers/table-worker.js",
    "worker:sign": "node workers/sign-worker.js",
    "worker:optimize": "node workers/optimize-worker.js",
    "docker:build": "docker build -t pdf-suite-backend .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "express": "^4.18.2",
    "bullmq": "^5.8.0",
    "ioredis": "^5.3.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "uuid": "^9.0.0",
    "mime-types": "^2.1.35",
    "archiver": "^6.0.1",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}