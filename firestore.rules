rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /job_listings/{jobId} {
      allow read: if true; // public job feed
      allow write: if false; // written only by Cloud Functions (admin SDK)
    }

    match /user_profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /vault_documents/{docId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /chat_history/{msgId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
  }
}
